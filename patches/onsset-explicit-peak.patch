+    def _assert_positional_index(self, where):
+        """Fail loudly if row positions and index labels have diverged.
+
+        Technology.get_lcoe() mixes objects of two kinds: Series built from numpy
+        arrays (labelled 0..N-1 by POSITION) and columns taken straight off self.df
+        (labelled by the frame's INDEX). Pandas aligns those on labels. If the frame
+        has been sorted without resetting its index the two orderings differ, and
+        every stand-alone technology is sized against another settlement's capacity
+        factor - silently, because the energy term cancels out of the levelised cost
+        and only the capacity, investment and cost-band terms are left wrong.
+
+        This is not hypothetical: it is what condition_df() did before 2026-08-16.
+        """
+        if not self.df.index.equals(pd.RangeIndex(len(self.df))):
+            raise RuntimeError(
+                "self.df index is not a clean RangeIndex at {}. Row positions and "
+                "index labels have diverged, which silently misaligns stand-alone "
+                "capacity, investment and LCOE. Call "
+                "self.df.reset_index(drop=True, inplace=True) after whatever sorted "
+                "the frame.".format(where))
